# Optional absolute origin for server-side /api/health self-fetch in local/dev.
# On Vercel, VERCEL_URL is used automatically.
LEARN_ORIGIN=http://localhost:3000

# Learning account API (email/password auth proxy).
API_ORIGIN=https://api.forrovivo.com

# Shared with forrovivo-platform LEARNER_WEB_SERVICE_KEY (password-reset token handoff).
LEARNER_WEB_SERVICE_KEY=

# Resend transactional email for password resets.
RESEND_API_KEY=
RESEND_FROM_EMAIL=ForroVivo <noreply@forrovivo.com>
