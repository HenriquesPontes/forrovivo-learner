# Server-side API target. Use api-staging.forrovivo.com for staging acceptance.
API_ORIGIN=https://api.forrovivo.com
# Canonical origin for emailed reset links; preview deployments need an explicit override.
LEARN_ORIGIN=https://learn.forrovivo.com
# Match the Worker secret. Also signs browser session context for account isolation.
LEARNER_WEB_SERVICE_KEY=
# Required for password recovery. Missing configuration fails before requesting a token.
RESEND_API_KEY=
RESEND_FROM_EMAIL=ForroVivo <hello@forrovivo.com>
# Optional public OAuth settings. Empty providers show an unavailable button, without an SDK.
# Configure each audience on the Worker and its origin/redirect with the provider first.
NEXT_PUBLIC_GOOGLE_WEB_CLIENT_ID=
NEXT_PUBLIC_APPLE_WEB_CLIENT_ID=
NEXT_PUBLIC_APPLE_WEB_REDIRECT_URI=https://learn.forrovivo.com/
